# Root-relative patterns are anchored with a leading `/`: an unanchored
# `data/` would also swallow src/vela/data/, and `*.html` the front end.

# Python
__pycache__/
*.py[cod]
*.egg-info/
/.venv/
/dist/
/build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage

# Credentials live in ~/.antlia (API keys) and ~/ib-gateway (the gateway), never
# in the repo -- but a stray copy here must not be one `git add .` away from
# being published. `.env` also holds which warmed symbol and window the
# real-data tests read: research identity, not code.
credentials.toml
.env

# Editor configs are local-only: launch configurations are exactly where a key
# gets pasted "just for a second", and where real symbols, windows and tuned
# parameters live.
.vscode/

# LLM instruction files are local-only. They record live account numbers,
# measured vendor entitlements and research detail that must not ship -- this
# repo is public -- and they are written for whoever picks the work up next,
# not for the reader of the repo. README.md is the public document. They live
# in claude-docs, its own private repo, cloned here and linked in.
/claude-docs/
CLAUDE.md
AGENTS.md
.claude/
.cursor/
.cursorrules
.github/agents/
.aider*

# antlia's local data tiers
/data/

# vela: run artifacts and private config
/runs/
/config/*.json
!/config/*.example.json
/settings.json

# pictor: rendered dashboards dropped at the repo root. Anchored, so it never
# reaches web/index.html, src/pictor/_web/ or the publish templates -- widen it
# to a blanket `*.html` and the built front end silently stops being committed.
/*.html
# The front-end build: node_modules is disposable, src/pictor/_web is committed.
/web/node_modules/
# CloudBase tooling scratch; regenerated on demand, nothing here reads it
/.cloudbase/
